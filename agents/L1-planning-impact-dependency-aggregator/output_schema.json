{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.internal/agents/L1-planning-impact-dependency-aggregator/output_schema.json",
  "title": "L1-planning-impact-dependency-aggregator Output",
  "description": "content.items carries the product name, source artifact references, and aggregation metadata. The full combined document lives in artifact-001 (L1-impact-assessment-dependency-graph.md).",
  "type": "object",
  "required": ["agent_id", "agent_version", "execution_id", "workflow_execution_id", "status", "content"],
  "properties": {
    "agent_id": { "const": "L1-planning-impact-dependency-aggregator" },
    "agent_version": { "type": "string" },
    "execution_id": { "type": "string", "pattern": "^exec-" },
    "workflow_execution_id": { "type": "string", "pattern": "^wf-" },
    "status": { "type": "string", "enum": ["success", "failed"] },
    "content": {
      "type": "object",
      "required": ["type", "schema_version", "items", "artifacts", "execution_summary"],
      "properties": {
        "type": { "const": "impact_dependency_aggregation" },
        "schema_version": { "const": "1.0" },
        "items": {
          "type": "object",
          "required": ["product_name", "source_artifacts", "aggregation_method", "sections_included"],
          "properties": {
            "product_name": { "type": "string" },
            "source_artifacts": {
              "type": "object",
              "required": ["impact_assessment", "dependency_graph_mmd"],
              "properties": {
                "impact_assessment": {
                  "type": "object",
                  "required": ["name", "blob_storage_url"],
                  "properties": {
                    "name": { "const": "L1-impact-assessment.md" },
                    "blob_storage_url": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "dependency_graph_mmd": {
                  "type": "object",
                  "required": ["name", "blob_storage_url"],
                  "properties": {
                    "name": { "const": "L1-dependency-graph.mmd" },
                    "blob_storage_url": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "aggregation_method": { "const": "verbatim-concatenation" },
            "sections_included": {
              "type": "array",
              "items": { "type": "string", "enum": ["impact-assessment", "dependency-graph-mermaid"] },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "description": "0 items only for an INSUFFICIENT_CONTEXT run; a completed run always has exactly 1.",
          "items": { "$ref": "#/$defs/Artifact" }
        },
        "execution_summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "Artifact": {
      "type": "object",
      "required": ["id", "type", "name", "format", "storage", "description", "produced_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^artifact-[0-9]+$" },
        "type": { "const": "document" },
        "name": { "const": "L1-impact-assessment-dependency-graph.md" },
        "format": { "const": "markdown" },
        "storage": {
          "type": "object",
          "required": ["provider", "location"],
          "properties": {
            "provider": { "type": "string", "enum": ["s3", "local", "confluence", "github", "jira_attachment"] },
            "location": { "type": "string" },
            "blob_storage_url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" },
        "produced_by": { "const": "L1-planning-impact-dependency-aggregator" }
      },
      "additionalProperties": false
    }
  }
}

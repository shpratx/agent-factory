{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L1-inception-requirements-extractor Output",
  "type": "object",
  "required": ["agent_id", "agent_version", "execution_id", "workflow_execution_id", "status", "content"],
  "properties": {
    "agent_id": {"type": "string", "const": "L1-inception-requirements-extractor"},
    "agent_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "execution_id": {"type": "string", "pattern": "^exec-.+$"},
    "workflow_execution_id": {"type": ["string", "null"], "pattern": "^wf-.+$"},
    "status": {"type": "string", "enum": ["success", "failed"]},
    "content": {
      "type": "object",
      "required": ["type", "schema_version", "items", "execution_summary"],
      "properties": {
        "type": {"type": "string", "const": "prd_document"},
        "schema_version": {"type": "string", "const": "1.0"},
        "items": {
          "type": "object",
          "required": ["product_name", "document_summary", "artifact"],
          "properties": {
            "product_name": {"type": "string"},
            "document_summary": {
              "type": "object",
              "required": ["total_requirements", "by_category"],
              "properties": {
                "total_requirements": {"type": "integer", "minimum": 0},
                "by_category": {
                  "type": "object",
                  "properties": {
                    "FR": {"type": "integer"}, "NFR": {"type": "integer"}, "CON": {"type": "integer"},
                    "ASM": {"type": "integer"}, "GAP": {"type": "integer"}, "DEP": {"type": "integer"},
                    "DR": {"type": "integer"}, "INT": {"type": "integer"}, "SM": {"type": "integer"},
                    "RSK": {"type": "integer"}
                  }
                }
              }
            },
            "artifact": {
              "type": "object",
              "required": ["type", "format", "location"],
              "properties": {
                "type": {"type": "string", "const": "prd_document"},
                "format": {"type": "string", "const": "markdown"},
                "location": {"type": "string", "description": "Blob storage URL where the PRD was uploaded"}
              }
            }
          }
        },
        "execution_summary": {"type": "string", "minLength": 50}
      }
    }
  }
}

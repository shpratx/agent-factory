# gr-L1-pii-detection — Prompt-Only Mode
# Layer: L1 — Enterprise (all agents)
# Triggers on: output

define bot refuse to respond
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output contains real personally identifiable information (PII)\", \"severity\": \"high\", \"category\": \"pii\", \"rail\": \"output\"}"

define bot inform cannot answer
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output contains real personally identifiable information (PII)\", \"severity\": \"high\", \"category\": \"pii\", \"rail\": \"output\"}"

define bot inform answer unknown
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output contains real personally identifiable information (PII)\", \"severity\": \"high\", \"category\": \"pii\", \"rail\": \"output\"}"


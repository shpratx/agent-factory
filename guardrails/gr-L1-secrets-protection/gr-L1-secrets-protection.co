# gr-L1-secrets-protection — Prompt-Only Mode
# Layer: L1 — Enterprise (all agents)
# Triggers on: output

define bot refuse to respond
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output contains credentials, secrets, or sensitive system details\", \"severity\": \"critical\", \"category\": \"secrets\", \"rail\": \"output\"}"

define bot inform cannot answer
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output contains credentials, secrets, or sensitive system details\", \"severity\": \"critical\", \"category\": \"secrets\", \"rail\": \"output\"}"

define bot inform answer unknown
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output contains credentials, secrets, or sensitive system details\", \"severity\": \"critical\", \"category\": \"secrets\", \"rail\": \"output\"}"


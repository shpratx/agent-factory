# gr-L1-input-validator — Prompt-Only Mode
# Layer: L1
# Triggers on: input

define bot refuse to respond
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Input is malformed, empty, or not a legitimate request the agent can handle\", \"severity\": \"medium\", \"category\": \"invalid_input\", \"rail\": \"input\"}"

define bot inform cannot answer
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Input is malformed, empty, or not a legitimate request the agent can handle\", \"severity\": \"medium\", \"category\": \"invalid_input\", \"rail\": \"input\"}"

define bot inform answer unknown
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Input is malformed, empty, or not a legitimate request the agent can handle\", \"severity\": \"medium\", \"category\": \"invalid_input\", \"rail\": \"input\"}"

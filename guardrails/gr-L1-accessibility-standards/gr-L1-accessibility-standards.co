define bot refuse to respond
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Response does not meet accessibility standards (WCAG 2.1 AA, EN 301 549)\", \"severity\": \"medium\", \"category\": \"accessibility\", \"rail\": \"output\"}"

define bot inform cannot answer
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Response does not meet accessibility standards (WCAG 2.1 AA, EN 301 549)\", \"severity\": \"medium\", \"category\": \"accessibility\", \"rail\": \"output\"}"

define bot inform answer unknown

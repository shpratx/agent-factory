# gr-L1-output-schema-validator — Prompt-Only Mode
# Layer: L1
# Triggers on: output

define bot refuse to respond
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output does not conform to the AgentOutput schema: required fields are missing, malformed, or null\", \"severity\": \"high\", \"category\": \"schema_validation\", \"rail\": \"output\"}"

define bot inform cannot answer
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output does not conform to the AgentOutput schema: required fields are missing, malformed, or null\", \"severity\": \"high\", \"category\": \"schema_validation\", \"rail\": \"output\"}"

define bot inform answer unknown
  "{\"detected\": true, \"verdict\": \"rejected\", \"reason\": \"Output does not conform to the AgentOutput schema: required fields are missing, malformed, or null\", \"severity\": \"high\", \"category\": \"schema_validation\", \"rail\": \"output\"}"


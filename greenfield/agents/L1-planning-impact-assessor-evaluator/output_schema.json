{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "L1-planning-impact-assessment-evaluator/output_schema.json",
  "title": "L1-planning-impact-assessment-evaluator items",
  "description": "Nests inside the standard AgentOutput envelope (content.items). Findings/fixes cover BOTH halves of the generator's output: the impact assessment (capability check, technical-touch) and the dependency graph (cycle_check, critical_path, MMD rendering).",
  "type": "object",
  "required": ["scores", "overall_score", "pass", "findings", "fixes_applied", "final_decision"],
  "properties": {
    "scores": {
      "type": "object",
      "required": ["faithfulness", "hallucination", "consistency", "relevance", "reasoning_quality"],
      "properties": {
        "faithfulness": { "type": "number", "minimum": 0, "maximum": 1 },
        "hallucination": { "type": "number", "minimum": 0, "maximum": 1 },
        "consistency": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasoning_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "citation_completeness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "pass": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Finding" }
    },
    "fixes_applied": {
      "type": "array",
      "items": { "$ref": "#/$defs/Fix" }
    },
    "final_decision": {
      "type": "string",
      "enum": ["approved", "fixed_and_approved", "escalate_to_hitl"]
    }
  },
  "$defs": {
    "Finding": {
      "type": "object",
      "description": "A single re-verification result. `gate` names which check produced it (e.g. capability-check, technical-touch, cycle-check, critical-path, edge-direction, mmd-structural, freshness-contamination, grounding).",
      "required": ["id", "gate", "status", "detail"],
      "properties": {
        "id": { "type": "string", "pattern": "^FND-[0-9]+$" },
        "gate": {
          "type": "string",
          "enum": [
            "capability-check",
            "technical-touch",
            "freshness-contamination",
            "fr-component-coverage",
            "cycle-check",
            "critical-path",
            "edge-direction",
            "grounding",
            "mmd-structural"
          ]
        },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "detail": {
          "type": "string",
          "description": "Must cite a specific ci_id, service_id, FR-id, node id, or edge (from/to)."
        }
      }
    },
    "Fix": {
      "type": "object",
      "required": ["id", "finding_id", "description", "before", "after"],
      "properties": {
        "id": { "type": "string", "pattern": "^FIX-[0-9]+$" },
        "finding_id": { "type": "string", "pattern": "^FND-[0-9]+$" },
        "description": { "type": "string", "description": "Includes the stated reasoning for the modification and which artifact(s) were overwritten (impact-assessment.md, dependency-graph.json, dependency-graph.mmd)." },
        "before": { "type": "string" },
        "after": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "L1-vision-workflow-summariser-output-schema-v1.0",
  "title": "WorkflowSummaryItems",
  "description": "Shape of content.items for L1-vision-workflow-summariser. This agent does NOT re-evaluate quality or transform artifacts — it reads every prior agent's output in L1-WF-vision-idea-to-statement and reports intent, execution flow, and outcome for audit purposes.",
  "type": "object",
  "required": ["intent", "execution_flow", "outcome"],
  "properties": {
    "intent": { "type": "string", "description": "One sentence: what this workflow run was trying to achieve" },
    "execution_flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_number", "agent", "outcome"],
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "agent": { "type": "string" },
          "outcome": { "type": "string", "enum": ["approved", "fixed_and_approved", "escalated_to_hitl", "failed_insufficient_context"] },
          "note": { "type": "string" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["final_status", "viability_score", "artifact"],
      "properties": {
        "final_status": { "type": "string", "enum": ["ready_for_human_approval", "escalated", "failed"] },
        "viability_score": { "type": ["number", "null"] },
        "artifact": { "type": "string", "description": "The final artifact name, e.g. vision.md" },
        "open_risk_count": { "type": "integer", "minimum": 0 },
        "escalation_reason": { "type": ["string", "null"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.internal/agents/L1-planning-impact-dependency-mapper/output_schema.json",
  "title": "L1-planning-impact-dependency-mapper Output",
  "description": "content.items carries meta-point summaries ONLY for narrative fields (impact_summary, rationale_summary are distillations, maxLength-capped — the full text lives in artifact-001, L1-impact-assessment.md). dependency_graph's nodes/edges/cycle_check/critical_path are structural data, not prose, and are carried in FULL — they are simultaneously the item content and the verbatim content saved to artifact-002/artifact-003.",
  "type": "object",
  "required": ["agent_id", "agent_version", "execution_id", "workflow_execution_id", "status", "content"],
  "properties": {
    "agent_id": { "const": "L1-planning-impact-dependency-mapper" },
    "agent_version": { "type": "string" },
    "execution_id": { "type": "string", "pattern": "^exec-" },
    "workflow_execution_id": { "type": "string", "pattern": "^wf-" },
    "status": { "type": "string", "enum": ["success", "failed"] },
    "content": {
      "type": "object",
      "required": ["type", "schema_version", "items", "artifacts", "execution_summary"],
      "properties": {
        "type": { "const": "impact_dependency_assessment" },
        "schema_version": { "const": "1.0" },
        "items": {
          "type": "object",
          "required": ["impact_assessment", "dependency_graph"],
          "properties": {
            "impact_assessment": { "$ref": "#/$defs/ImpactAssessmentMeta" },
            "dependency_graph": { "$ref": "#/$defs/DependencyGraph" }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "description": "0 items only for an INSUFFICIENT_CONTEXT run where neither phase produced a document; a completed run (success or a Phase B FAIL) always has all 3.",
          "items": { "$ref": "#/$defs/Artifact" }
        },
        "execution_summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "ImpactAssessmentMeta": {
      "type": "object",
      "description": "Meta-point summary of L1-impact-assessment.md — the full document is artifact-001.",
      "required": ["product_name", "overall_impact_level", "impact_summary", "components_identified", "existing_systems_touched", "existing_systems_excluded", "external_dependencies_count", "flags"],
      "properties": {
        "product_name": { "type": "string" },
        "overall_impact_level": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "impact_summary": {
          "type": "string",
          "maxLength": 150,
          "description": "Distillation only (~15-20 words) — the full Impact Summary section lives in artifact-001."
        },
        "components_identified": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["requirement", "component", "component_type", "blast_radius", "rationale_summary"],
            "properties": {
              "requirement": { "type": "string", "pattern": "^FR-[0-9]+$" },
              "component": { "type": "string" },
              "component_type": { "type": "string", "enum": ["new", "existing"] },
              "blast_radius": { "type": "string", "enum": ["Low", "Medium", "High"] },
              "rationale_summary": { "type": "string", "maxLength": 150 }
            },
            "additionalProperties": false
          }
        },
        "existing_systems_touched": { "type": "integer", "minimum": 0 },
        "existing_systems_excluded": { "type": "integer", "minimum": 0 },
        "external_dependencies_count": { "type": "integer", "minimum": 0 },
        "flags": { "type": "array", "items": { "type": "string", "maxLength": 150 } }
      },
      "additionalProperties": false
    },
    "DependencyGraph": {
      "type": "object",
      "description": "Structural data, carried in full — identical in substance to artifact-002 (L1-dependency-graph.json).",
      "required": ["nodes", "edges", "cycle_check", "critical_path"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "type": { "type": "string", "enum": ["component", "external-dependency"] },
              "label": { "type": "string" },
              "source_requirement": {
                "type": "array",
                "items": { "type": "string", "pattern": "^FR-[0-9]+$" }
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "type"],
            "properties": {
              "from": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "to": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "type": { "type": "string", "enum": ["depends-on", "blocks", "integrates-with"] }
            },
            "additionalProperties": false
          }
        },
        "cycle_check": {
          "type": "object",
          "required": ["status", "cycles_found"],
          "properties": {
            "status": { "type": "string", "enum": ["PASS", "FAIL"] },
            "cycles_found": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
            }
          },
          "additionalProperties": false
        },
        "critical_path": {
          "type": "object",
          "required": ["nodes", "rationale"],
          "properties": {
            "nodes": { "type": "array", "items": { "type": "string" } },
            "rationale": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "required": ["id", "type", "name", "format", "storage", "description", "produced_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^artifact-[0-9]+$" },
        "type": { "const": "document" },
        "name": { "type": "string" },
        "format": { "type": "string", "enum": ["markdown", "json", "mermaid"] },
        "storage": {
          "type": "object",
          "required": ["provider", "location"],
          "properties": {
            "provider": { "type": "string", "enum": ["s3", "local", "confluence", "github", "jira_attachment"] },
            "location": { "type": "string" },
            "blob_storage_url": { "type": "string" },
            "mmd_blob_storage_url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" },
        "produced_by": { "const": "L1-planning-impact-dependency-mapper" }
      },
      "additionalProperties": false
    }
  }
}

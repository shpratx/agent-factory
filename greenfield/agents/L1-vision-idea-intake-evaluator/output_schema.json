{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "L1-vision-idea-intake-evaluator-output-schema-v1.0",
  "title": "EvaluatorItems",
  "description": "Shared shape across all Phase 0 evaluator agents (S6 pattern). Scores are read from the paired generator's evaluation.md at runtime — this schema does not duplicate the rubric, only the result shape.",
  "type": "object",
  "required": ["scores", "overall_score", "pass", "findings", "fixes_applied", "final_decision"],
  "properties": {
    "scores": {
      "type": "object",
      "required": ["faithfulness", "hallucination", "consistency", "relevance", "reasoning_quality"],
      "properties": {
        "faithfulness": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "hallucination": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "Lower is better — this is a rate, not a pass score" },
        "consistency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "relevance": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reasoning_quality": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "citation_completeness": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "description": "null if the generator's evaluation.md marks this N/A" }
      }
    },
    "overall_score": { "type": "number", "minimum": 0.0, "maximum": 10.0 },
    "pass": { "type": "boolean", "description": "overall_score >= the paired generator's spec.yaml quality.min_score" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gate", "status", "detail"],
        "properties": {
          "id": { "type": "string", "pattern": "^FND-[0-9]{2}$" },
          "gate": { "type": "string", "description": "Which evaluation.md Quality Gate or Reflection Checklist item this finding is about" },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "detail": { "type": "string", "minLength": 10 }
        }
      }
    },
    "fixes_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "finding_id", "description", "before", "after"],
        "properties": {
          "id": { "type": "string", "pattern": "^FIX-[0-9]{2}$" },
          "finding_id": { "type": "string", "pattern": "^FND-[0-9]{2}$" },
          "description": { "type": "string" },
          "before": { "type": "string" },
          "after": { "type": "string" }
        }
      }
    },
    "final_decision": {
      "type": "string",
      "enum": ["approved", "fixed_and_approved", "escalate_to_hitl"],
      "description": "approved = passed with no fixes needed; fixed_and_approved = failed findings were fixed and now pass; escalate_to_hitl = could not fix to a passing score"
    }
  }
}

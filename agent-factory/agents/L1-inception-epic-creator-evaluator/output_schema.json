{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents/L1-inception-epics-creator-evaluator/output_schema.json",
  "title": "L1-inception-epics-creator-evaluator Output — L1-epics.json (overwritten in place)",
  "description": "Defines agent_id/agent_version/status/content for this agent, nested within the standard AgentOutput v2 envelope (schemas/agent-output-schema.json). content.items is the corrected/final Epics set (same shape as L1-inception-epics-creator's own content.items). content.evaluation carries the rubric-wise audit trail. This evaluator overwrites the SAME blob file (L1-epics.json) that the core Epics Creator wrote.",
  "type": "object",
  "required": ["agent_id", "agent_version", "execution_id", "workflow_execution_id", "status", "content"],
  "properties": {
    "agent_id": { "const": "L1-inception-epics-creator-evaluator" },
    "agent_version": { "type": "string" },
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[0-9a-fA-F-]{36}$",
      "description": "Newly generated (format exec-<uuid>) for this specific execution."
    },
    "workflow_execution_id": {
      "type": "string",
      "pattern": "^wf-[0-9a-fA-F-]{36}$",
      "description": "Inherited verbatim from the upstream AgentOutput's workflow_execution_id (originated by L1-inception-epics-creator). This agent never generates its own."
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed"],
      "description": "'failed' only when the candidate L1-epics.json or its source L1-prd.md could not be read/parsed at all, or the candidate has zero epics with no recoverable content."
    },
    "content": {
      "type": "object",
      "required": ["type", "schema_version", "items", "evaluation", "artifacts", "execution_summary"],
      "properties": {
        "type": { "const": "epics" },
        "schema_version": { "const": "1.0" },
        "items": {
          "type": "object",
          "description": "The corrected/final Epics set — identical shape to L1-inception-epics-creator's own content.items.",
          "required": ["epics"],
          "properties": {
            "epics": { "type": "array", "items": { "$ref": "#/$defs/Epic" } },
            "gaps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evaluation": {
          "type": "object",
          "required": ["scores", "overall_score", "pass", "findings", "fixes_applied", "final_decision"],
          "properties": {
            "scores": {
              "type": "object",
              "description": "8 domain-specific rubric scores, each 0.0-1.0. Derived analogously to L1-inception-feature-decomposer-evaluator's real-world score names, adapted to Epic/PRD altitude.",
              "required": ["faithfulness", "completeness", "schema_compliance", "regulatory_accuracy", "prd_traceability", "cardinality_compliance", "title_and_altitude_quality", "risk_filtering_quality"],
              "properties": {
                "faithfulness": { "type": "number", "minimum": 0, "maximum": 1 },
                "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
                "schema_compliance": { "type": "number", "minimum": 0, "maximum": 1 },
                "regulatory_accuracy": { "type": "number", "minimum": 0, "maximum": 1, "description": "Correctness of risk category/severity/target_date and constraint accuracy relative to the PRD." },
                "prd_traceability": { "type": "number", "minimum": 0, "maximum": 1, "description": "Every Epic field traces to the exact PRD file/section; prd_reference matches the actual source." },
                "cardinality_compliance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Adherence to kb-epics-best-practices §2.5 PRD-to-Epic Cardinality Rule (correct Epic count for the PRD's initiative structure)." },
                "title_and_altitude_quality": { "type": "number", "minimum": 0, "maximum": 1, "description": "Title 3-5 words, pillar altitude, no leaked Feature/Story detail, formatting rules." },
                "risk_filtering_quality": { "type": "number", "minimum": 0, "maximum": 1, "description": "Only Critical Compliance Threshold risks retained; no general delivery risks leaked in." }
              }
            },
            "overall_score": { "type": "number", "minimum": 0, "maximum": 10, "description": "Average of the 8 scores * 10, rounded to 2 decimals." },
            "pass": { "type": "boolean", "description": "true unless final_decision == 'escalate_to_hitl'." },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "gate", "status", "detail"],
                "properties": {
                  "id": { "type": "string", "pattern": "^FND-[0-9]{2}$" },
                  "gate": { "type": "string", "description": "One of the 8 score names above." },
                  "status": { "type": "string", "enum": ["pass", "fail"] },
                  "detail": { "type": "string" }
                }
              }
            },
            "fixes_applied": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "finding_id", "description", "before", "after", "reasoning"],
                "properties": {
                  "id": { "type": "string", "pattern": "^FIX-[0-9]{2}$" },
                  "finding_id": { "type": "string", "pattern": "^FND-[0-9]{2}$" },
                  "description": { "type": "string" },
                  "before": { "type": "string" },
                  "after": { "type": "string" },
                  "reasoning": { "type": "string" }
                }
              }
            },
            "final_decision": {
              "type": "string",
              "enum": ["approved", "fixed_and_approved", "escalate_to_hitl"],
              "description": "approved = every finding passed. fixed_and_approved = one or more findings failed but all were fixed. escalate_to_hitl = one or more failed findings could not be safely fixed (e.g. source PRD unreadable) and require human review."
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "description": "Always includes the L1-epics.json blob artifact this execution overwrote in place.",
          "items": { "$ref": "#/$defs/Artifact" }
        },
        "execution_summary": { "type": "string", "description": "Plain-text bullet points. Never JSON." }
      }
    }
  },
  "$defs": {
    "Artifact": {
      "type": "object",
      "required": ["id", "type", "name", "format", "storage", "produced_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^artifact-.+$" },
        "type": { "const": "document" },
        "name": { "const": "L1-epics.json" },
        "format": { "const": "json" },
        "storage": {
          "type": "object",
          "required": ["provider", "location"],
          "properties": {
            "provider": { "const": "blob_storage" },
            "location": { "type": "string", "description": "The literal blob_storage_url returned by the blob-storage-writer tool. Never fabricated." }
          }
        },
        "description": { "type": "string", "description": "e.g. 'Overwritten in place with the corrected Epics output.'" },
        "produced_by": { "const": "L1-inception-epics-creator-evaluator" }
      }
    },
    "PrdReference": {
      "type": "object",
      "required": ["file", "file_path"],
      "properties": {
        "file": { "type": "string" },
        "file_path": { "type": "string" },
        "sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Citation": {
      "type": "object",
      "required": ["source_section", "quoted_phrase"],
      "properties": {
        "source_section": { "type": "string" },
        "quoted_phrase": { "type": "string" }
      }
    },
    "ItemMetadata": {
      "type": "object",
      "required": ["confidence", "reasoning", "citation", "trajectory"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasoning": { "type": "string" },
        "citation": { "$ref": "#/$defs/Citation" },
        "trajectory": { "type": "string" }
      }
    },
    "Risk": {
      "type": "object",
      "required": ["category", "statement", "severity", "metadata"],
      "properties": {
        "category": { "type": "string", "enum": ["FDA", "SQF", "HACCP", "USDA", "Recall/Traceability", "Other-Critical-Compliance"] },
        "statement": { "type": "string" },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium"] },
        "target_date": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/ItemMetadata" }
      }
    },
    "ReferenceLink": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "Epic": {
      "type": "object",
      "required": [
        "epic_id", "title", "summary", "user_value_statement",
        "macro_feature_pillars", "out_of_scope", "constraints",
        "regulatory_food_safety_risks", "reference_links", "prd_reference", "metadata"
      ],
      "properties": {
        "epic_id": { "type": "string", "pattern": "^EP-[0-9]{2}$" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "user_value_statement": { "type": "string" },
        "macro_feature_pillars": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["pillar", "metadata"],
            "properties": {
              "pillar": { "type": "string" },
              "metadata": { "$ref": "#/$defs/ItemMetadata" }
            }
          }
        },
        "out_of_scope": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "regulatory_food_safety_risks": { "type": "array", "items": { "$ref": "#/$defs/Risk" } },
        "reference_links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ReferenceLink" } },
        "prd_reference": { "$ref": "#/$defs/PrdReference" },
        "metadata": { "$ref": "#/$defs/ItemMetadata" }
      }
    }
  }
}
